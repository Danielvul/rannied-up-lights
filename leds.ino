  for (uint16_t i = 0; i < n; i++) {
    JACKPOT_FINALE_RT[i] = JACKPOT_FINALE_TEMPLATE[i];
    // Apply vibrato rate only to steps that have vibrato depth
    if (JACKPOT_FINALE_RT[i].vibDepthHz > 0) {
      JACKPOT_FINALE_RT[i].vibRateMs = vibRateMs;
    }
  }
}

// Calibration
const int calibrationSamples=50;
const int allowedDifferential=10;
int minDistanceYellow = 30; //Default, will be overridden during calibration
int maxDistanceYellow=50; //Default, will be overridden during calibration
int minDistanceBlue=30; //Default, will be overridden during calibration
int maxDistanceBlue=50; //Default, will be overridden during calibration

// Real Detected Distances
int distanceBlue; //variable to store distance from the blue sensor
int distanceYellow; //variable to store distance from the yellow sensor

// Animation states
enum AnimationState {
  STATE_ATTRACT,
  STATE_WIN_CHEERS,
  STATE_WIN_BUILDUP,
  STATE_WIN_EXPLOSION,
  STATE_WIN_CHASE,
  STATE_WIN_SPARKLE,
  STATE_WIN_FINALE
};

// Globals
Adafruit_NeoPixel strip(LED_COUNT, LED_PIN, NEO_GRB + NEO_KHZ800);
AnimationState currentState = STATE_ATTRACT;
unsigned long lastUpdate = 0;
uint16_t animationFrame = 0;
unsigned long lastDetectionCheck = 0; // Last time we ran cornball detection
bool pendingStartupChirp = true; // play a short beep after boot to verify audio

void setup() {
  Serial.begin(115200);
  randomSeed(analogRead(A0));

  strip.begin();
  strip.setBrightness(BRIGHTNESS_ATTRACT);
  strip.show();
  Serial.println("Pinball LED Controller Ready");

  usonicsetup(TRIGBLUE, ECHOBLUE); //set up center ultrasonic sensor
  usonicsetup(TRIGYELLOW, ECHOYELLOW); //set up right ultrasonic sensor

  calibrateCornballDetection();

  // Audio setup
  pinMode(AUDIO_OUTPUT_PIN, OUTPUT);
  digitalWrite(AUDIO_OUTPUT_PIN, LOW);
}

void loop() {
  unsigned long now = millis();
  // Update audio engine every loop (runs even during attract)
  updateTone();
  updateSong();

  // Startup chirp once after power-up to verify audio path
  if (pendingStartupChirp && now > 300) {
    pendingStartupChirp = false;
    startToneWithEffects(880, 200, 0, 0, 0); // 880Hz, 200ms
  }
  // Ensure audio is fully off in attract mode
  if (currentState == STATE_ATTRACT && (isSongActive || isToneActive)) {
    isSongActive = false;
    isSongLooping = false;
    stopTone();
  }
  // Non-blocking cornball detection on schedule (only in attract mode)
  if (currentState == STATE_ATTRACT) {
    if (now - lastDetectionCheck >= DETECTION_SCHEDULE) {
      lastDetectionCheck = now;
      if (detectCornball()) {
        Serial.println("Cornball detected");
        startWinAnimation();
      }
    }
  }
  
  // Update animation based on state
  unsigned long updateInterval = (currentState == STATE_ATTRACT) ? ATTRACT_UPDATE : WIN_UPDATE;
  
  if (now - lastUpdate >= updateInterval) {
    lastUpdate = now;
    animationFrame++;
    
    switch (currentState) {
      case STATE_ATTRACT:
        attractMode();
        break;
      case STATE_WIN_CHEERS:
        winCheers();
        break;
      case STATE_WIN_BUILDUP:
        winBuildup();
        break;
      case STATE_WIN_EXPLOSION:
        winExplosion();
        break;
      case STATE_WIN_CHASE:
        winChase();
        break;
      case STATE_WIN_SPARKLE:
        winSparkle();
        break;
      case STATE_WIN_FINALE:
        winFinale();
        break;
    }
  }

  // Update audio engine every loop
  updateTone();
  updateSong();
}

// ============================================================================
// CORNBALL LOGIC
// ============================================================================

void calibrateCornballDetection() {
    Serial.println("Calibrating >>>");
    long sumBlue = 0;
    long sumYellow = 0;
  
    for (int i = 0; i < calibrationSamples; i++) {
      measureAllDistances();        // updates distanceBlue and distanceYellow
      sumBlue += distanceBlue;
      sumYellow += distanceYellow;
      delay(CALIBRATION_DELAY_MS); // small delay to stabilize readings
    }
  
    int avgBlue = sumBlue / calibrationSamples;
    int avgYellow = sumYellow / calibrationSamples;
  
    maxDistanceYellow = avgYellow + allowedDifferential;
    minDistanceYellow = avgYellow - allowedDifferential;
    maxDistanceBlue = avgBlue + allowedDifferential;
    minDistanceBlue = avgBlue - allowedDifferential;
    
    Serial.print("Average Blue Distance: ");
    Serial.println(avgBlue);
    Serial.print("Min Blue Distance: ");
    Serial.println(minDistanceBlue);
    Serial.print("Max Blue Distance: ");
    Serial.println(maxDistanceBlue);
    Serial.print("Average Yellow Distance: ");
    Serial.println(avgYellow);
    Serial.print("Min Yellow Distance: ");
    Serial.println(minDistanceYellow);
    Serial.print("Max Yellow Distance: ");
    Serial.println(maxDistanceYellow);
    Serial.println("Calibrated.");
    
  }

void measureAllDistances() {
    distanceBlue = usonic(11600, TRIGBLUE, ECHOBLUE) / 58; //distance in cm, time out at 11600us or 2m maximum range
    distanceYellow = u28Read(TRIGYELLOW, ECHOYELLOW);
}

// Mock: returns true if a cornball is detected. Replace with real sensor logic.
bool detectCornball() {
    measureAllDistances();
    return (distanceBlue < minDistanceBlue || distanceBlue > maxDistanceBlue || distanceYellow < minDistanceYellow || distanceYellow > maxDistanceYellow);
}

void startWinAnimation() {
  currentState = STATE_WIN_CHEERS;
  strip.setBrightness(BRIGHTNESS_WIN);
  animationFrame = 0;
  Serial.println("WIN!");
}


// ============================================================================
// USONIC FUNCTIONS
// ============================================================================
void usonicsetup(int triggerPin, int echoPin) {
    pinMode(echoPin, INPUT);
    pinMode(triggerPin, OUTPUT);
    digitalWrite(triggerPin, LOW);
  }
  
  long u28Read(int triggerPin, int echoPin) {
    long duration;
  
    if (digitalRead(echoPin) == HIGH) {
      return 0;
    } //if echo line is still high from last result,return 0;
  
    digitalWrite(triggerPin, HIGH); //send trigger pulse
    delayMicroseconds(10);
    digitalWrite(triggerPin, LOW);
  
    duration = pulseIn(echoPin, HIGH, 10000);
    
    if (duration == 0) { //If there was a timeout, the pulse will return 0. I prefer 200 because it says far away
      return 200;
    }
  
    return duration / 58;
  }
  
  long usonic(long utimeout, int triggerPin, int echoPin) { //utimeout is maximum time to wait for return in us
  
    long b;
  
    if (digitalRead(echoPin) == HIGH) {
      return 0;
    } //if echo line is still high from last result,return 0;
  
    digitalWrite(triggerPin, HIGH); //send trigger pulse
    delay(1);
    digitalWrite(triggerPin, LOW);
  
    long utimer = micros();
  
    while ((digitalRead(echoPin) == LOW) && ((micros() - utimer) < 1000)) { } //wait for pin state to change, return starts after 460us typically or timeout (eg if not connected)
  
    utimer = micros();
  
    while ((digitalRead(echoPin) == HIGH) && ((micros() - utimer) < utimeout)) {} //wait for pin state to change
    b = micros() - utimer;
  
    if (b == 0) {
      b = utimeout;
    }
    return b;
  }

// ============================================================================
// ATTRACT MODE - Pinball idle patterns
// ============================================================================

void attractMode() {
  strip.clear();
  
  // Pulsing red comet chasing around the strip
  int cometLength = 15;
  int cometPos = (animationFrame / 2) % LED_COUNT;
  
  for (int i = 0; i < cometLength; i++) {
    int pos = (cometPos - i + LED_COUNT) % LED_COUNT;
    float brightness = (float)(cometLength - i) / cometLength;
    brightness = brightness * brightness; // Exponential falloff
    
    uint8_t r = COLOR_RED_R * brightness;
    uint8_t g = COLOR_RED_G * brightness;
    uint8_t b = COLOR_RED_B * brightness;
    
    strip.setPixelColor(pos, strip.Color(r, g, b));
  }
  
  // Add occasional gold sparkles
  if (animationFrame % 40 < 2) {
    int sparklePos = random(LED_COUNT);
    strip.setPixelColor(sparklePos, strip.Color(COLOR_GOLD_R, COLOR_GOLD_G, COLOR_GOLD_B));
  }
  
  strip.show();
}

// ============================================================================
// WIN ANIMATIONS - Celebratory sequences
// ============================================================================

void winBuildup() {
  if (animationFrame == 1) {
    startSong(JACKPOT_BUILDUP, (uint16_t)(sizeof(JACKPOT_BUILDUP)/sizeof(JACKPOT_BUILDUP[0])), true);
  }
  // Rapid strobing getting faster - builds anticipation
  if (animationFrame < 60) {
    int strobeSpeed = 20 - (animationFrame / 4);
    if (strobeSpeed < 3) strobeSpeed = 3;
    
    if ((animationFrame % strobeSpeed) < strobeSpeed / 2) {
      strip.fill(strip.Color(COLOR_RED_R, COLOR_RED_G, COLOR_RED_B));
    } else {
      strip.fill(strip.Color(COLOR_GOLD_R, COLOR_GOLD_G, COLOR_GOLD_B));
    }
  } else {
    // Transition to explosion
    currentState = STATE_WIN_EXPLOSION;
    animationFrame = 0;
  }
  strip.show();
}

void winExplosion() {
  if (animationFrame == 1) {
    startSong(JACKPOT_EXPLOSION, (uint16_t)(sizeof(JACKPOT_EXPLOSION)/sizeof(JACKPOT_EXPLOSION[0])), true);
  }
  // Explosion from center outward
  if (animationFrame < 60) {
    int radius = animationFrame * 2;
    strip.clear();
    
    int center = LED_COUNT / 2;
    for (int i = 0; i < radius && i < LED_COUNT / 2; i++) {
      int pos1 = center + i;
      int pos2 = center - i;
      
      float brightness = 1.0f - ((float)i / (float)max(1, radius));
      uint8_t baseR = (animationFrame % 4 < 2) ? COLOR_RED_R : COLOR_GOLD_R;
      uint8_t baseG = (animationFrame % 4 < 2) ? COLOR_RED_G : COLOR_GOLD_G;
      uint8_t baseB = (animationFrame % 4 < 2) ? COLOR_RED_B : COLOR_GOLD_B;
      uint8_t r = (uint8_t)(baseR * brightness);
      uint8_t g = (uint8_t)(baseG * brightness);
      uint8_t b = (uint8_t)(baseB * brightness);
      
      if (pos1 < LED_COUNT) strip.setPixelColor(pos1, strip.Color(r, g, b));
      if (pos2 >= 0) strip.setPixelColor(pos2, strip.Color(r, g, b));
    }
  } else {
    currentState = STATE_WIN_CHASE;
    animationFrame = 0;
  }
  strip.show();
}

void winCheers() {
  if (animationFrame == 1) {
    startSong(JACKPOT_CHEERS, (uint16_t)(sizeof(JACKPOT_CHEERS)/sizeof(JACKPOT_CHEERS[0])), true);
  }
  // Beer cheers animation - two glasses start close, move apart, cheers together, move apart
  strip.clear();
  
  int glassWidth = 10; // Width of each "glass"
  int center = LED_COUNT / 2;
  int separation;
  
  // Animation phases
  if (animationFrame < 20) {
    // Phase 1: Start close together
    separation = 15;
  } else if (animationFrame < 50) {
    // Phase 2: Move down/apart
    separation = 15 + (animationFrame - 20);
  } else if (animationFrame < 70) {
    // Phase 3: Quick cheers - come back together!
    int phase = animationFrame - 50;
    separation = 45 - (phase * 2);
  } else if (animationFrame < 100) {
    // Phase 4: Move apart again
    separation = 5 + (animationFrame - 70);
  } else {
    // Transition to next animation (now go to buildup)
    currentState = STATE_WIN_BUILDUP;
    animationFrame = 0;
    strip.show();
    return;
  }
  
  // During the big cheers phase, enforce a 6-LED gap between glasses at center
  if (animationFrame >= 50 && animationFrame < 70) {
    const int minGap = 6; // LEDs
    int separationMin = (glassWidth + minGap + 1) / 2; // ceil((glassWidth + gap)/2)
    if (separation < separationMin) separation = separationMin;
  }
  
  // Draw left glass (golden beer)
  int leftGlassCenter = center - separation;
  for (int i = 0; i < glassWidth; i++) {
    int pos = leftGlassCenter - glassWidth/2 + i;
    if (pos >= 0 && pos < LED_COUNT) {
      // Make the center brighter (more beer foam)
      float brightness = 1.0 - abs((float)(i - glassWidth/2) / (glassWidth/2)) * 0.3;
      uint8_t r = COLOR_GOLD_R * brightness;
      uint8_t g = COLOR_GOLD_G * brightness;
      uint8_t b = COLOR_GOLD_B * brightness;
      strip.setPixelColor(pos, strip.Color(r, g, b));
    }
  }
  
  // Draw right glass (golden beer)
  int rightGlassCenter = center + separation;
  for (int i = 0; i < glassWidth; i++) {
    int pos = rightGlassCenter - glassWidth/2 + i;
    if (pos >= 0 && pos < LED_COUNT) {
      // Make the center brighter (more beer foam)
      float brightness = 1.0 - abs((float)(i - glassWidth/2) / (glassWidth/2)) * 0.3;
      uint8_t r = COLOR_GOLD_R * brightness;
      uint8_t g = COLOR_GOLD_G * brightness;
      uint8_t b = COLOR_GOLD_B * brightness;
      strip.setPixelColor(pos, strip.Color(r, g, b));
    }
  }
  
  // Add sparkle effect during the "cheers" moment
  if (animationFrame >= 50 && animationFrame < 70) {
    // Add some sparkles when glasses clink
    for (int i = 0; i < 5; i++) {
      int sparklePos = random(LED_COUNT);
      if (random(10) < 5) {
        strip.setPixelColor(sparklePos, strip.Color(255, 255, 255)); // White sparkles
      }
    }
  }
  
  strip.show();
}

void winChase() {
  if (animationFrame == 1) {
    startSong(JACKPOT_CHASE, (uint16_t)(sizeof(JACKPOT_CHASE)/sizeof(JACKPOT_CHASE[0])), true);
  }
  // Dual chasing lights from both ends
  if (animationFrame < 120) {
    strip.clear();
    
    int chaseWidth = 8;
    int pos1 = (animationFrame * 2) % LED_COUNT;
    int pos2 = (LED_COUNT - (animationFrame * 2)) % LED_COUNT;
    
    for (int i = 0; i < chaseWidth; i++) {
      int p1 = (pos1 + i) % LED_COUNT;
      int p2 = (pos2 - i + LED_COUNT) % LED_COUNT;
      
      uint32_t color1 = strip.Color(COLOR_RED_R, COLOR_RED_G, COLOR_RED_B);
      uint32_t color2 = strip.Color(COLOR_GOLD_R, COLOR_GOLD_G, COLOR_GOLD_B);
      
      strip.setPixelColor(p1, color1);
      strip.setPixelColor(p2, color2);
    }
  } else {
    currentState = STATE_WIN_SPARKLE;
    animationFrame = 0;
  }
  strip.show();
}

void winSparkle() {
  if (animationFrame == 1) {
    startSong(JACKPOT_SPARKLE, (uint16_t)(sizeof(JACKPOT_SPARKLE)/sizeof(JACKPOT_SPARKLE[0])), true);
  }
  // Random sparkles fill up the strip
  if (animationFrame < 100) {
    // Add random sparkles
    for (int i = 0; i < 3; i++) {
      int pos = random(LED_COUNT);
      uint32_t color = (random(2) == 0) 
        ? strip.Color(COLOR_RED_R, COLOR_RED_G, COLOR_RED_B)
        : strip.Color(COLOR_GOLD_R, COLOR_GOLD_G, COLOR_GOLD_B);
      strip.setPixelColor(pos, color);
    }
    
    // Fade all pixels slightly
    if (animationFrame % 3 == 0) {
      for (int i = 0; i < LED_COUNT; i++) {
        uint32_t c = strip.getPixelColor(i);
        uint8_t r = (c >> 16) & 0xFF;
        uint8_t g = (c >> 8) & 0xFF;
        uint8_t b = c & 0xFF;
        
        r = (uint8_t)(r * 0.95f);
        g = (uint8_t)(g * 0.95f);
        b = (uint8_t)(b * 0.95f);
        
        strip.setPixelColor(i, strip.Color(r, g, b));
      }
    }
  } else {
    currentState = STATE_WIN_FINALE;
    animationFrame = 0;
  }
  strip.show();
}

void winFinale() {
  if (animationFrame == 1) {
    // Sync wobble LFO to light wave: half-period is ~10 frames => 10*WIN_UPDATE ms
    prepareFinaleSong((uint16_t)(10 * WIN_UPDATE));
    startSong(JACKPOT_FINALE_RT, (uint16_t)(sizeof(JACKPOT_FINALE_RT)/sizeof(JACKPOT_FINALE_RT[0])), true);
  }
  // Final wave sweep and return to attract mode
  if (animationFrame < 80) {
    strip.clear();
    
    for (int i = 0; i < LED_COUNT; i++) {
      float wave = sin(((float)i / LED_COUNT + (float)animationFrame / 40.0) * PI * 4);
      if (wave > 0) {
        uint8_t brightness = wave * 255;
        uint8_t r = (COLOR_RED_R * brightness) / 255;
        uint8_t g = (COLOR_RED_G * brightness) / 255;
        uint8_t b = (COLOR_RED_B * brightness) / 255;
        
        // Mix in gold on peaks
        if (wave > 0.7) {
          r = (COLOR_GOLD_R * brightness) / 255;
          g = (COLOR_GOLD_G * brightness) / 255;
          b = (COLOR_GOLD_B * brightness) / 255;
        }
        
        strip.setPixelColor(i, strip.Color(r, g, b));
      }
    }
  } else {
    // Return to attract mode
    currentState = STATE_ATTRACT;
    strip.setBrightness(BRIGHTNESS_ATTRACT);
    animationFrame = 0;
    // Hard stop any audio when exiting win sequence
    isSongActive = false;
    isSongLooping = false;
    stopTone();
  }
  strip.show();
}
