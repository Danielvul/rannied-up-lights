// ===========================
// Non-blocking Audio Engine
// ===========================

// Forward declaration to satisfy Arduino's autogenerated prototypes
struct SongStep;

// Tone generation state
volatile bool isToneActive = false;
volatile uint16_t activeFrequencyHz = 0;
volatile unsigned long toneStopTimeMs = 0;
volatile unsigned long lastToggleTimeMicros = 0;
volatile unsigned long halfPeriodMicros = 0;

// Effects state
volatile uint16_t sweepStartHz = 0;
volatile uint16_t sweepTargetHz = 0;
volatile unsigned long stepStartTimeMs = 0;
volatile unsigned long stepDurationMs = 0;
volatile uint16_t vibratoDepthHz = 0;   // peak deviation
volatile uint16_t vibratoRateMs = 0;    // toggle rate (triangle LFO)
volatile unsigned long lastVibratoToggleMs = 0;
volatile int8_t vibratoSign = 1;
volatile uint16_t lastAppliedFreqHz = 0;

// Non-blocking: start tone with optional effects
void startToneWithEffects(uint16_t frequencyHz, unsigned long durationMs, uint16_t sweepToHz, uint16_t vibDepthHz, uint16_t vibRateMs) {
  if (frequencyHz == 0) return;
  activeFrequencyHz = frequencyHz;
  halfPeriodMicros = 500000UL / (unsigned long)frequencyHz;
  toneStopTimeMs = millis() + durationMs;
  lastToggleTimeMicros = micros();
  stepStartTimeMs = millis();
  stepDurationMs = durationMs;
  sweepStartHz = frequencyHz;
  sweepTargetHz = sweepToHz;
  vibratoDepthHz = vibDepthHz;
  vibratoRateMs = vibRateMs;
  lastVibratoToggleMs = millis();
  vibratoSign = 1;
  lastAppliedFreqHz = 0;
  isToneActive = true;
}

void stopTone() {
  isToneActive = false;
  digitalWrite(AUDIO_OUTPUT_PIN, LOW);
  sweepStartHz = 0;
  sweepTargetHz = 0;
  vibratoDepthHz = 0;
  vibratoRateMs = 0;
}

// Must be called often from loop
void updateTone() {
  if (!isToneActive) return;
  if ((long)(millis() - toneStopTimeMs) >= 0) { stopTone(); return; }

  // Compute effective frequency with sweep and vibrato
  unsigned long nowMs = millis();
  uint16_t effFreq = activeFrequencyHz;
  if (sweepTargetHz > 0 && stepDurationMs > 0) {
    unsigned long elapsed = nowMs - stepStartTimeMs;
    if (elapsed > stepDurationMs) elapsed = stepDurationMs;
    long delta = (long)sweepTargetHz - (long)sweepStartHz;
    effFreq = (uint16_t)((long)sweepStartHz + (delta * (long)elapsed) / (long)stepDurationMs);
    if (effFreq == 0) effFreq = 1;
  }
  if (vibratoDepthHz > 0 && vibratoRateMs > 0) {
    if ((nowMs - lastVibratoToggleMs) >= vibratoRateMs) { lastVibratoToggleMs += vibratoRateMs; vibratoSign = -vibratoSign; }
    long v = (long)effFreq + (long)vibratoSign * (long)vibratoDepthHz;
    if (v < 1) v = 1; effFreq = (uint16_t)v;
  }
  if (effFreq != lastAppliedFreqHz) { halfPeriodMicros = 500000UL / (unsigned long)effFreq; lastAppliedFreqHz = effFreq; }

  unsigned long nowMicros = micros();
  if ((nowMicros - lastToggleTimeMicros) >= halfPeriodMicros) {
    lastToggleTimeMicros += halfPeriodMicros;
    digitalWrite(AUDIO_OUTPUT_PIN, !digitalRead(AUDIO_OUTPUT_PIN));
  }
}

// Song sequencer
struct SongStep {
  uint16_t freqHz;     // 0 for rest
  uint16_t durationMs; // duration of this step
  uint16_t sweepToHz;  // 0 for none
  uint16_t vibDepthHz; // 0 for none
  uint16_t vibRateMs;  // LFO toggle rate
};

// Note frequencies
const uint16_t NOTE_C3 = 131, NOTE_D3 = 147, NOTE_E3 = 165, NOTE_F3 = 175, NOTE_G3 = 196, NOTE_A3 = 220, NOTE_B3 = 247;
const uint16_t NOTE_C4 = 262, NOTE_D4 = 294, NOTE_E4 = 330, NOTE_F4 = 349, NOTE_G4 = 392, NOTE_A4 = 440, NOTE_B4 = 494;
const uint16_t NOTE_C5 = 523, NOTE_D5 = 587, NOTE_E5 = 659, NOTE_F5 = 698, NOTE_G5 = 784, NOTE_A5 = 880, NOTE_B5 = 988;
const uint16_t NOTE_C6 = 1047, NOTE_D6 = 1175, NOTE_E6 = 1319, NOTE_G6 = 1568;

volatile bool isSongActive = false;
volatile bool isSongLooping = false;
const SongStep* currentSong = nullptr;
uint16_t currentSongLength = 0;
uint16_t currentStepIndex = 0;
unsigned long stepEndTimeMs = 0;

void startSong(const SongStep* steps, uint16_t length, bool loopSong) {
  currentSong = steps;
  currentSongLength = length;
  currentStepIndex = 0;
  isSongActive = (steps && length > 0);
  isSongLooping = loopSong;
  stepEndTimeMs = 0;
}

void updateSong() {
  if (!isSongActive || currentSong == nullptr) return;
  unsigned long nowMs = millis();
  if (stepEndTimeMs == 0 || (long)(nowMs - stepEndTimeMs) >= 0) {
    if (currentStepIndex >= currentSongLength) {
      if (isSongLooping) {
        currentStepIndex = 0; // loop the song for the duration of the state
      } else {
        isSongActive = false; stopTone(); return;
      }
    }
    SongStep step = currentSong[currentStepIndex++];
    stepEndTimeMs = nowMs + step.durationMs;
    if (step.freqHz == 0) { stopTone(); }
    else { startToneWithEffects(step.freqHz, step.durationMs, step.sweepToHz, step.vibDepthHz, step.vibRateMs); }
  }
}

